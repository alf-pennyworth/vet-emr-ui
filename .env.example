# VetVoice EMR — Environment Variables
# Copy this file to .env.local and fill in your real keys.

# AssemblyAI — speech-to-text transcription
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Ollama — local LLM inference for clinical extraction
# Default points to local Ollama. Change if using a remote inference server.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Local audio upload storage directory
UPLOADS_DIR=./uploads
